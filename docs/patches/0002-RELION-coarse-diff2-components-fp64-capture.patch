+		unsigned long * d_iorient,
+		double * d_allweights,
+		double * d_mweights,
+		unsigned long orientation_num,
+		unsigned long translation_num,
+		int block_size
+		)
+{
+	size_t idx = blockIdx.x * block_size + threadIdx.x;

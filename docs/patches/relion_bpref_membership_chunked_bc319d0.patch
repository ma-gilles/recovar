+void relion_capture_bpref_membership_v1(
+	MlOptimiser *baseMLO,
+	OptimisationParamters &op,
+	ProjectionParams &projection_data,
+	unsigned long iclass,
+	unsigned long orientation_num,
+	unsigned long translation_num,
+	XFLOAT *weights,
+	XFLOAT significant_weight,
+	XFLOAT weight_norm,
+	AccPtr<XFLOAT> &eulers,
+	int img_id,
+	deviceStream_t stream)
+{
+	const RelionBprefMembershipConfigV1 &config = relion_bpm_config_v1();
+	if (!config.enabled || static_cast<std::uint64_t>(baseMLO->iter) != config.iteration
+		|| iclass + 1 != config.class_one_based)
+		return;
+	if (!relion_bpm_part_id_selected(config, static_cast<std::uint64_t>(op.part_id)))
+		return;
+	if (sizeof(XFLOAT) != sizeof(float))
+		REPORT_ERROR("RELION BPref membership schema v1 requires float32 XFLOAT");
+	if (orientation_num == 0 || translation_num == 0)
+		REPORT_ERROR("RELION BPref membership capture saw empty orientation/translation support");
+	if (orientation_num > UINT32_MAX)
+		REPORT_ERROR("RELION BPref membership orientation count exceeds the schema-v1 identity width");
+
+	const std::uint64_t weight_count = orientation_num * translation_num;
+	if (weight_count / translation_num != orientation_num)
+		REPORT_ERROR("RELION BPref membership weight count overflow");
+	const std::uint64_t artifact_bytes = sizeof(RelionBprefMembershipHeaderV1)
+		+ orientation_num * sizeof(RelionBprefPreScatterRotationV1)
+		+ weight_count * sizeof(float)
+		+ sizeof(RelionBprefMembershipFooterV1);
+	const std::uint64_t estimated_max_bytes = artifact_bytes
+		* config.max_particles_per_rank * config.expected_followers;
+	if (estimated_max_bytes > config.max_bytes)
+		REPORT_ERROR("RELION BPref membership runtime dimensions exceed RELION_BPM_CAPTURE_MAX_BYTES");
+
+	std::vector<float> posterior_weights(weight_count);
+	DEBUG_HANDLE_ERROR(cudaMemcpyAsync(
+		posterior_weights.data(), weights, weight_count * sizeof(float),
+		cudaMemcpyDeviceToHost, stream));
+	DEBUG_HANDLE_ERROR(cudaStreamSynchronize(stream));
+
+	std::uint64_t reservation = relion_bpm_files_reserved_v1.fetch_add(1);
+	if (reservation >= config.max_particles_per_rank)
+		REPORT_ERROR("RELION BPref membership capture exceeded MAX_PARTICLES_PER_RANK");
+
+	FileName image_name = baseMLO->mydata.particles[op.part_id].name;
+	FileName stack_name;
+	long int stack_index = -1;
+	image_name.decompose(stack_index, stack_name);
+	if (stack_index < 0 || stack_name.empty())
+		REPORT_ERROR("RELION BPref membership capture could not resolve canonical stack identity");
+
+	std::vector<RelionBprefPreScatterRotationV1> rotations(orientation_num);
+	const std::size_t class_offset = projection_data.class_idx[iclass];
+	if (class_offset + orientation_num > projection_data.iorientclasses.size()
+		|| class_offset + orientation_num > projection_data.iover_rots.size())
+		REPORT_ERROR("RELION BPref membership orientation identity range is incomplete");
+	for (std::size_t orientation = 0; orientation < orientation_num; orientation++)
+	{
+		RelionBprefPreScatterRotationV1 &rotation = rotations[orientation];
+		rotation.orientation_class_key = projection_data.iorientclasses[class_offset + orientation];
+		rotation.oversampled_rotation = projection_data.iover_rots[class_offset + orientation];
+		rotation.orientation_local = orientation;
+		rotation.reserved = 0;
+		for (std::size_t element = 0; element < 9; element++)
+			rotation.matrix[element] = eulers[orientation * 9 + element];
+	}
+
+	RelionBprefMembershipHeaderV1 header = {};
+	std::memcpy(header.magic, "RLNBPMV1HEADER", 14);
+	header.values[0] = 1;
+	header.values[1] = sizeof(header);
+	header.values[2] = sizeof(RelionBprefPreScatterRotationV1);
+	header.values[3] = sizeof(float);
+	header.values[4] = sizeof(RelionBprefMembershipFooterV1);
+	header.values[5] = baseMLO->iter;
+	header.values[6] = iclass + 1;
+	header.values[7] = op.part_id;
+	header.values[8] = stack_index;
+	header.values[9] = img_id;
+	header.values[10] = static_cast<std::uint64_t>(relion_bpre_mpi_rank());
+	header.values[11] = omp_get_thread_num();
+	header.values[12] = orientation_num;
+	header.values[13] = translation_num;
+	header.values[14] = weight_count;
+	header.values[15] = relion_bpre_float_bits(static_cast<float>(significant_weight));
+	header.values[16] = relion_bpre_float_bits(static_cast<float>(weight_norm));
+	header.values[17] = config.expected_particles;
+	header.values[18] = config.max_particles_per_rank;
+	header.values[19] = config.expected_followers;
+	header.values[20] = config.max_bytes;
+	header.values[21] = estimated_max_bytes;
+	header.values[22] = relion_bpre_fnv1a64(stack_name);
+	header.values[23] = relion_bpre_fnv1a64(image_name);
+	header.values[24] = 1; // device-to-host diagnostic copy after production backprojection
+	header.values[25] = baseMLO->mymodel.current_size;
+
+	RelionBprefMembershipFooterV1 footer = {};
+	std::memcpy(footer.magic, "RLNBPMV1FOOTER", 14);
+	footer.weight_count = posterior_weights.size();
+	footer.rotation_count = rotations.size();
+
+	std::string basename = config.directory + "/part" + std::to_string(op.part_id)
+		+ "_stack" + std::to_string(stack_index) + "_img" + std::to_string(img_id)
+		+ "_class" + std::to_string(iclass + 1) + ".bpm-v1.bin";
+	std::string temporary = basename + ".tmp." + std::to_string(getpid())
+		+ "." + std::to_string(omp_get_thread_num());
+	struct stat existing;
+	if (stat(basename.c_str(), &existing) == 0 || stat(temporary.c_str(), &existing) == 0)
+		REPORT_ERROR("RELION BPref membership capture refuses to overwrite an existing artifact");
+	std::ofstream output(temporary, std::ios::binary | std::ios::out | std::ios::trunc);
+	if (!output)
+		REPORT_ERROR("Cannot create RELION BPref membership temporary artifact");
+	output.write(reinterpret_cast<const char *>(&header), sizeof(header));
+	output.write(reinterpret_cast<const char *>(rotations.data()), rotations.size() * sizeof(rotations[0]));
+	output.write(reinterpret_cast<const char *>(posterior_weights.data()),
+		posterior_weights.size() * sizeof(posterior_weights[0]));
+	output.write(reinterpret_cast<const char *>(&footer), sizeof(footer));
+	output.close();
+	if (!output || rename(temporary.c_str(), basename.c_str()) != 0)
+		REPORT_ERROR("Cannot seal RELION BPref membership artifact");
+}
 }

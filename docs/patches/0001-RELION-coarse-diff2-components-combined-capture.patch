+bool relion_should_capture_coarse_pass1_v1(
+	MlOptimiser *baseMLO,
+	OptimisationParamters &op)
+{
+	const RelionCoarsePass1ConfigV1 &config = relion_p1_config_v1();
+	return config.enabled
+		&& static_cast<std::uint64_t>(baseMLO->iter) == config.iteration
+		&& relion_p1_part_id_selected(config, static_cast<std::uint64_t>(op.part_id));
+}
+
+void relion_capture_coarse_pass1_v1(
+	MlOptimiser *baseMLO,
+	OptimisationParamters &op,
+	SamplingParameters &sp,
+	const std::vector<float> &raw_diff2,
+	const XFLOAT *posterior_weights,
+	const std::vector<float> &reference_norms,
+	const std::vector<float> &cross_terms)
+{
+	const RelionCoarsePass1ConfigV1 &config = relion_p1_config_v1();
+	if (!relion_should_capture_coarse_pass1_v1(baseMLO, op))
+		return;
+	if (sizeof(XFLOAT) != sizeof(float))
+		REPORT_ERROR("RELION coarse-pass1 schema v1 requires float32 XFLOAT");
+	if (sp.iclass_min != 0 || sp.iclass_max != 0)
+		REPORT_ERROR("RELION coarse-pass1 schema v1 is intentionally restricted to K=1");
+
+	const std::uint64_t candidate_count =
+		static_cast<std::uint64_t>(sp.nr_dir) * sp.nr_psi * sp.nr_trans;
+	if (candidate_count == 0 || raw_diff2.size() != candidate_count)
+		REPORT_ERROR("RELION coarse-pass1 capture saw an invalid candidate count");
+	const bool has_components = config.schema == 2;
+	if (has_components
+		&& (reference_norms.size() != candidate_count
+			|| cross_terms.size() != candidate_count))
+		REPORT_ERROR("RELION coarse-pass1 schema v2 requires two complete component arrays");
+	if (!has_components && (!reference_norms.empty() || !cross_terms.empty()))
+		REPORT_ERROR("RELION coarse-pass1 schema v1 refuses component arrays");
+
+	std::vector<std::uint8_t> significant_mask(candidate_count);
+	std::uint64_t significant_count = 0;
+	for (std::uint64_t index = 0; index < candidate_count; index++)
+	{
+		significant_mask[index] = DIRECT_A1D_ELEM(op.Mcoarse_significant, index) ? 1 : 0;
+		significant_count += significant_mask[index];
+	}
+
+	const std::uint64_t translation_value_count = 2 * static_cast<std::uint64_t>(sp.nr_trans);
+	const std::uint64_t artifact_bytes = sizeof(RelionCoarsePass1HeaderV1)
+		+ (has_components ? 4 : 2) * candidate_count * sizeof(float)
+		+ candidate_count * sizeof(std::uint8_t)
+		+ translation_value_count * sizeof(float)
+		+ sizeof(RelionCoarsePass1FooterV1);
+	const std::uint64_t estimated_max_bytes = artifact_bytes
+		* config.max_particles_per_rank * config.expected_followers;
+	if (estimated_max_bytes > config.max_bytes)
+		REPORT_ERROR("RELION coarse-pass1 runtime dimensions exceed RELION_P1_CAPTURE_MAX_BYTES");
+
+	std::uint64_t reservation = relion_p1_files_reserved_v1.fetch_add(1);
+	if (reservation >= config.max_particles_per_rank)
+		REPORT_ERROR("RELION coarse-pass1 capture exceeded MAX_PARTICLES_PER_RANK");
+
+	FileName image_name = baseMLO->mydata.particles[op.part_id].name;
+	FileName stack_name;
+	long int stack_index = -1;
+	image_name.decompose(stack_index, stack_name);
+	if (stack_index < 0 || stack_name.empty())
+		REPORT_ERROR("RELION coarse-pass1 capture could not resolve canonical stack identity");
+
+	std::vector<float> weights(candidate_count);
+	for (std::uint64_t index = 0; index < candidate_count; index++)
+		weights[index] = static_cast<float>(posterior_weights[index]);
+	std::vector<float> translations(translation_value_count);
+	for (std::uint64_t index = 0; index < static_cast<std::uint64_t>(sp.nr_trans); index++)
+	{
+		translations[2 * index] = static_cast<float>(baseMLO->sampling.translations_x[index]);
+		translations[2 * index + 1] = static_cast<float>(baseMLO->sampling.translations_y[index]);
+	}
+
+	RelionCoarsePass1HeaderV1 header = {};
+	std::memcpy(
+		header.magic,
+		has_components ? "RLNP1V2HEADER" : "RLNP1V1HEADER",
+		13);
+	header.values[0] = config.schema;
+	header.values[1] = sizeof(header);
+	header.values[2] = sizeof(float);
+	header.values[3] = sizeof(std::uint8_t);
+	header.values[4] = sizeof(RelionCoarsePass1FooterV1);
+	header.values[5] = baseMLO->iter;
+	header.values[6] = op.part_id;
+	header.values[7] = stack_index;
+	header.values[8] = static_cast<std::uint64_t>(relion_bpre_mpi_rank());
+	header.values[9] = omp_get_thread_num();
+	header.values[10] = sp.nr_dir;
+	header.values[11] = sp.nr_psi;
+	header.values[12] = sp.nr_trans;
+	header.values[13] = candidate_count;
+	header.values[14] = significant_count;
+	header.values[15] = op.max_index.coarseIdx;
+	header.values[16] = relion_bpre_float_bits(static_cast<float>(op.significant_weight));
+	header.values[17] = relion_bpre_float_bits(static_cast<float>(op.sum_weight));
+	header.values[18] = relion_bpre_float_bits(static_cast<float>(op.max_weight));
+	header.values[19] = relion_bpre_float_bits(static_cast<float>(op.min_diff2));
+	header.values[20] = config.expected_particles;
+	header.values[21] = config.max_particles_per_rank;
+	header.values[22] = config.expected_followers;
+	header.values[23] = config.max_bytes;
+	header.values[24] = estimated_max_bytes;
+	header.values[25] = relion_bpre_fnv1a64(stack_name);
+	header.values[26] = relion_bpre_fnv1a64(image_name);
+	header.values[27] = baseMLO->mymodel.current_size;
+	header.values[28] = relion_bpre_float_bits(static_cast<float>(baseMLO->adaptive_fraction));
+	header.values[29] = static_cast<std::uint64_t>(baseMLO->maximum_significants);
+	header.values[30] = translation_value_count;
+	header.values[31] = 1; // raw diff2 copied before prior/weight conversion
+	header.values[32] = 1; // post-prior production weights copied after conversion
+	header.values[33] = 1; // exact production coarse-significance mask
+	header.values[34] = has_components ? 1 : 0; // reference-norm component
+	header.values[35] = has_components ? 1 : 0; // image/reference cross component
+	header.values[36] = config.schema;
+
+	RelionCoarsePass1FooterV1 footer = {};
+	std::memcpy(
+		footer.magic,
+		has_components ? "RLNP1V2FOOTER" : "RLNP1V1FOOTER",
+		13);
+	footer.candidate_count = candidate_count;
+	footer.significant_count = significant_count;
+
+	std::string basename = config.directory + "/part" + std::to_string(op.part_id)
+		+ "_stack" + std::to_string(stack_index)
+		+ (has_components ? ".p1-v2.bin" : ".p1-v1.bin");
+	std::string temporary = basename + ".tmp." + std::to_string(getpid())
+		+ "." + std::to_string(omp_get_thread_num());
+	struct stat existing;
+	if (stat(basename.c_str(), &existing) == 0 || stat(temporary.c_str(), &existing) == 0)
+		REPORT_ERROR("RELION coarse-pass1 capture refuses to overwrite an existing artifact");
+	std::ofstream output(temporary, std::ios::binary | std::ios::out | std::ios::trunc);
+	if (!output)
+		REPORT_ERROR("Cannot create RELION coarse-pass1 temporary artifact");
+	output.write(reinterpret_cast<const char *>(&header), sizeof(header));
+	output.write(reinterpret_cast<const char *>(raw_diff2.data()), raw_diff2.size() * sizeof(raw_diff2[0]));
+	output.write(reinterpret_cast<const char *>(weights.data()), weights.size() * sizeof(weights[0]));
+	if (has_components)
+	{
+		output.write(
+			reinterpret_cast<const char *>(reference_norms.data()),
+			reference_norms.size() * sizeof(reference_norms[0]));
+		output.write(
+			reinterpret_cast<const char *>(cross_terms.data()),
+			cross_terms.size() * sizeof(cross_terms[0]));
+	}
+	output.write(reinterpret_cast<const char *>(significant_mask.data()),
+		significant_mask.size() * sizeof(significant_mask[0]));
+	output.write(reinterpret_cast<const char *>(translations.data()),
+		translations.size() * sizeof(translations[0]));
+	output.write(reinterpret_cast<const char *>(&footer), sizeof(footer));
+	output.close();
+	if (!output || rename(temporary.c_str(), basename.c_str()) != 0)
+		REPORT_ERROR("Cannot seal RELION coarse-pass1 artifact");
+}
 }

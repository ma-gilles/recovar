 #include <stdio.h>
 #include <stdlib.h>
 
+static const char* const DISPATCH_LOG_SCHEMA_MARKER = "RELION_DISPATCH_LOG_SCHEMA_V2";
+
+static void writeExpectationDispatchLog(
+	long int iteration,
+	const std::vector<int>& follower_by_sorted_position,
+	const std::vector<long int>& sorted_idx)
+{
+	const char* path = std::getenv("RELION_DISPATCH_LOG");
+	if (path == NULL || path[0] == '\0')
+		return;
+	if (follower_by_sorted_position.size() != sorted_idx.size())
+		REPORT_ERROR("Internal error while writing RELION_DISPATCH_LOG: inconsistent particle counts");
+
+	std::ofstream log(path, std::ios::out | std::ios::app);
+	if (!log)
+		REPORT_ERROR(std::string("Cannot append RELION_DISPATCH_LOG: ") + path);
+	if (log.tellp() == 0)
+		log << "# " << DISPATCH_LOG_SCHEMA_MARKER << '\n';
+	for (size_t sorted_position = 0; sorted_position < sorted_idx.size(); ++sorted_position)
+	{
+		const int follower_rank = follower_by_sorted_position[sorted_position];
+		if (follower_rank >= 0)
+			log << 2 << '\t' << iteration << '\t' << follower_rank << '\t'
+			    << sorted_position << '\t' << sorted_idx[sorted_position] << '\n';
+	}
+	log.close();
+	if (!log)
+		REPORT_ERROR(std::string("Cannot close RELION_DISPATCH_LOG: ") + path);
+}

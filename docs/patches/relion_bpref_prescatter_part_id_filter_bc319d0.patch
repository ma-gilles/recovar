+std::vector<std::uint64_t> relion_bpre_optional_u64_csv(const char *name)
+{
+	const char *text = std::getenv(name);
+	if (text == nullptr)
+		return {};
+	if (text[0] == '\0')
+		REPORT_ERROR(std::string("Empty particle identity list in ") + name);
+
+	std::vector<std::uint64_t> values;
+	const char *cursor = text;
+	while (*cursor != '\0')
+	{
+		if (*cursor < '0' || *cursor > '9')
+			REPORT_ERROR(std::string("Invalid comma-separated particle identity list in ") + name + ": " + text);
+		char *end = nullptr;
+		errno = 0;
+		unsigned long long value = std::strtoull(cursor, &end, 10);
+		if (errno != 0 || end == cursor || (*end != '\0' && *end != ','))
+			REPORT_ERROR(std::string("Invalid comma-separated particle identity list in ") + name + ": " + text);
+		for (std::uint64_t existing : values)
+			if (existing == static_cast<std::uint64_t>(value))
+				REPORT_ERROR(std::string("Duplicate particle identity in ") + name + ": " + text);
+		values.push_back(static_cast<std::uint64_t>(value));
+		if (*end == '\0')
+			break;
+		cursor = end + 1;
+		if (*cursor == '\0')
+			REPORT_ERROR(std::string("Trailing comma in particle identity list ") + name + ": " + text);
+	}
+	return values;
+}
+
+bool relion_bpre_part_id_selected(
+	const RelionBprefPreScatterConfigV1 &config,
+	std::uint64_t part_id)
+{
+	if (config.part_ids.empty())
+		return true;
+	for (std::uint64_t selected : config.part_ids)
+		if (selected == part_id)
+			return true;
+	return false;
+}

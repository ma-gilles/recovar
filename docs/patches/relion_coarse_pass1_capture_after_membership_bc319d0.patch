+const RelionCoarsePass1ConfigV1 &relion_p1_config_v1()
+{
+	static const RelionCoarsePass1ConfigV1 config = []()
+	{
+		RelionCoarsePass1ConfigV1 result = {};
+		const char *directory = std::getenv("RELION_P1_CAPTURE_DIR");
+		result.enabled = directory != nullptr && directory[0] != '\0';
+		if (!result.enabled)
+			return result;
+		result.directory = directory;
+		if (relion_bpre_required_u64("RELION_P1_CAPTURE_SCHEMA") != 1)
+			REPORT_ERROR("RELION_P1_CAPTURE_SCHEMA must be exactly 1");
+		result.iteration = relion_bpre_required_u64("RELION_P1_CAPTURE_ITER");
+		result.expected_particles = relion_bpre_required_u64("RELION_P1_CAPTURE_EXPECTED_PARTICLES");
+		result.max_particles_per_rank = relion_bpre_required_u64("RELION_P1_CAPTURE_MAX_PARTICLES_PER_RANK");
+		result.expected_followers = relion_bpre_required_u64("RELION_P1_CAPTURE_EXPECTED_FOLLOWERS");
+		result.max_bytes = relion_bpre_required_u64("RELION_P1_CAPTURE_MAX_BYTES");
+		result.part_ids = relion_bpre_optional_u64_csv("RELION_P1_CAPTURE_PART_IDS");
+		if (!result.part_ids.empty() && result.expected_particles != result.part_ids.size())
+			REPORT_ERROR("RELION_P1_CAPTURE_EXPECTED_PARTICLES must equal the explicit PART_IDS count");
+		if (result.expected_particles > result.max_particles_per_rank * result.expected_followers)
+			REPORT_ERROR("RELION coarse-pass1 capture cannot fit EXPECTED_PARTICLES within the explicit per-rank/follower cap");
+		struct stat status;
+		if (stat(result.directory.c_str(), &status) != 0 || !S_ISDIR(status.st_mode))
+			REPORT_ERROR("RELION_P1_CAPTURE_DIR must name an existing directory");
+		return result;
+	}();
+	return config;
+}

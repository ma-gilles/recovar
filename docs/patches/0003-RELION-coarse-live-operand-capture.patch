+// Passive coarse-reference capture. This uses the live production Euler
+// matrix, texture-backed AccProjectorKernel, pixel decoding, and
+// project3Dmodel call without reading or writing any score buffer.
+template<int block_sz>
+__global__ void cuda_kernel_capture_diff2_coarse_reference(
+		XFLOAT *g_eulers,
+		AccProjectorKernel projector,
+		XFLOAT *g_ref_real,
+		XFLOAT *g_ref_imag,
+		unsigned image_size,
+		unsigned long rotation_index)
+{
+	const unsigned long pixel = blockIdx.x * block_sz + threadIdx.x;
+	if (pixel >= image_size)
+		return;
+
+	int x = pixel % projector.imgX;
+	int y = floorfracf(pixel, projector.imgX);
+	if (y > projector.maxR)
+		y -= projector.imgY;
+
+	XFLOAT ref_real;
+	XFLOAT ref_imag;
+	projector.project3Dmodel(
+		x, y,
+		__ldg(&g_eulers[rotation_index * 9    ]),
+		__ldg(&g_eulers[rotation_index * 9 + 1]),
+		__ldg(&g_eulers[rotation_index * 9 + 3]),
+		__ldg(&g_eulers[rotation_index * 9 + 4]),
+		__ldg(&g_eulers[rotation_index * 9 + 6]),
+		__ldg(&g_eulers[rotation_index * 9 + 7]),
+		ref_real, ref_imag);
+	g_ref_real[pixel] = ref_real;
+	g_ref_imag[pixel] = ref_imag;
+}

+template<int block_sz>
+void capture_diff2_coarse_reference(
+		XFLOAT *g_eulers,
+		AccProjectorKernel projector,
+		XFLOAT *g_ref_real,
+		XFLOAT *g_ref_imag,
+		unsigned long image_size,
+		unsigned long rotation_index,
+		deviceStream_t stream)
+{
+#ifdef _CUDA_ENABLED
+	const unsigned long grid_size = (image_size + block_sz - 1) / block_sz;
+	cuda_kernel_capture_diff2_coarse_reference<block_sz>
+		<<<grid_size, block_sz, 0, stream>>>(
+			g_eulers,
+			projector,
+			g_ref_real,
+			g_ref_imag,
+			image_size,
+			rotation_index);
+#else
+	REPORT_ERROR("RELION coarse-reference capture is implemented only for CUDA");
+#endif
+}

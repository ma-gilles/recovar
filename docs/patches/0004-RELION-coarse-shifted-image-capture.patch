+// Passive capture of the exact translatePixel output consumed by the coarse
+// squared-difference kernel. This does not read or write any score buffer.
+template<int block_sz>
+__global__ void cuda_kernel_capture_diff2_coarse_shifted_images(
+		XFLOAT *trans_x,
+		XFLOAT *trans_y,
+		XFLOAT *g_real,
+		XFLOAT *g_imag,
+		AccProjectorKernel projector,
+		XFLOAT *g_shifted_real,
+		XFLOAT *g_shifted_imag,
+		unsigned image_size,
+		unsigned translation_num)
+{
+	const unsigned long index = blockIdx.x * block_sz + threadIdx.x;
+	const unsigned long value_count =
+		static_cast<unsigned long>(image_size) * translation_num;
+	if (index >= value_count)
+		return;
+
+	const unsigned translation = index / image_size;
+	const unsigned pixel = index % image_size;
+	const int x = pixel % projector.imgX;
+	int y = floorfracf(pixel, projector.imgX);
+	if (y > projector.maxR)
+		y -= projector.imgY;
+	translatePixel(
+		x, y,
+		trans_x[translation], trans_y[translation],
+		g_real[pixel], g_imag[pixel],
+		g_shifted_real[index], g_shifted_imag[index]);
+}

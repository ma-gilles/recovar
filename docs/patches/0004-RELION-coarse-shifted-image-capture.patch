+template<int block_sz>
+void capture_diff2_coarse_shifted_images(
+		XFLOAT *trans_x,
+		XFLOAT *trans_y,
+		XFLOAT *g_real,
+		XFLOAT *g_imag,
+		AccProjectorKernel projector,
+		XFLOAT *g_shifted_real,
+		XFLOAT *g_shifted_imag,
+		unsigned long image_size,
+		unsigned long translation_num,
+		deviceStream_t stream)
+{
+#ifdef _CUDA_ENABLED
+	const unsigned long value_count = image_size * translation_num;
+	const unsigned long grid_size = (value_count + block_sz - 1) / block_sz;
+	cuda_kernel_capture_diff2_coarse_shifted_images<block_sz>
+		<<<grid_size, block_sz, 0, stream>>>(
+			trans_x,
+			trans_y,
+			g_real,
+			g_imag,
+			projector,
+			g_shifted_real,
+			g_shifted_imag,
+			image_size,
+			translation_num);
+#else
+	REPORT_ERROR("RELION shifted-image capture is implemented only for CUDA");
+#endif
+}
